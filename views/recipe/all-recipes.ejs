<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>All Recipes</h1>

    <% for (let oneRecipe of allRecipes ){ %>
        <h3><%= oneRecipe.title %></h3>
        <p><%= oneRecipe.description %></p>
        <a href="/recipe/<%= oneRecipe._id %>">View Details</a>
    <% } %>
</body>
</html>