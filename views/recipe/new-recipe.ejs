<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new Recipe</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">

</head>
<body>
    <%- include('../partials/navbar') %>

    <h1 class="header">Create new Recipe</h1>

    <form class="form" action="/recipe" method="POST" enctype="multipart/form-data">
   
        <label for="title">Title:</label>
        <input type="text" id="title" name="title">
        <br><br>
        <label for="description">Description:</label>
        <textarea id="description" name="description" ></textarea>
        <br><br>
        <label for="category">Category:</label>
        <select id="category" name="category">
                <option value="" disabled selected hidden>Select a category</option>
            <% for (let oneCategory of categories) { %>
            <option value="<%= oneCategory._id %>"><%= oneCategory.name %></option>
            <% } %>
        </select>
        <br><br>
        <label for="Ingredients">Ingredients: </label>
        <div id="ingredientList">
            <div class="ingredientRow">
                <label>Name:</label>
                <input type="text" name="ingreName[]">
                <label>Quantity:</label>
                <input type="text" name="ingreQuan[]">
            </div>
        </div>
        <br>
        <button type="button" onclick="addIngredientRow()">Add Ingredient</button>
        <br><br>
        <label for="cookTime">Cook Time <span style="font-size: x-small;">'In minuts'</span> :</label>
        <input type="number" name="cookTime" id="cookTime">
        <br><br>
        <label for="steps">Steps:</label>
        <textarea id="steps" name="steps" ></textarea>
        <br><br>
        <label for="image">Upload Image</label>
        <input type="file" id="image" name="image"/>
        <br><br>
        <button type="submit" class="primary">Create Recipe</button>

    </form>

    <h3 class="back"><a href="/recipe"> ⬅ Go Back</a></h3>
    <br>
    <footer class="home-footer">
        <div>
            <h4>Recipe Box</h4>
            <p>Delicious ideas, one recipe at a time.</p>
        </div>
        <small>© <%= new Date().getFullYear() %> Recipe Box</small>
    </footer>

  <% const displayError = typeof error !== 'undefined' ? error : ''; %>
<div id="page-error" data-error="<%= displayError %>"></div>

<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
<script>
    const notyf = new Notyf({ position: { x: 'right', y: 'top' } });
    const pageError = document.getElementById('page-error').dataset.error;
    if (pageError) notyf.error(pageError);
</script>
    
    <script>
        function addIngredientRow() {
            const list = document.getElementById('ingredientList');
            const row = document.createElement('div');
            row.className = 'ingredientRow';
            row.innerHTML = `
                <label>Name:</label>
                <input type="text" name="ingreName[]">
                <label>Quantity:</label>
                <input type="text" name="ingreQuan[]">
            `;
            list.appendChild(row);
            console.log(list)
        }
    </script>
    
</body>
</html>