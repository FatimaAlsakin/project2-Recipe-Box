<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= recipe.title %> | Recipe Box</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css">

</head>
<body>
    <%- include('../partials/navbar') %>
    <main class="recipe-details-page">
        <div class="recipe-breadcrumb">
            <a href="/recipe">Recipes</a>
            <span>›</span>
            <% if (recipe.category) { %>
                <a href="/recipe?category=<%= recipe.category._id %>">
                    <%= recipe.category.name %></a>
                <span>›</span>
            <% } %>
            <strong><%= recipe.title %></strong>
        </div>

        <section class="recipe-details">

            <div class="recipe-details-image">
                <% if (recipe.image) { %>
                    <img src="<%= recipe.image %>" alt="<%= recipe.title %>">
                <% } else { %>
                    <div class="recipe-image-placeholder">🍽️</div>
                <% } %>
            </div>

            <div class="recipe-details-info">
                <h3 class="recipe-label">Recipe</h3>
                <h1><%= recipe.title %></h1>

                <% if (recipe.category) { %>
                    <a href="/recipe?category=<%= recipe.category._id %>" class="recipe-category-badge"> <%= recipe.category.name %></a>
                <% } %>

                <% if (recipe.description) { %>
                    <p class="recipe-short-description"><%= recipe.description %></p>
                <% } %>

                <div class="recipe-info-row">
                    <% if (recipe.cookTime) { %>
                    <div class="recipe-info-box">
                    <span class="recipe-info-icon">⏱</span>
                        <div>
                        <small>Cook Time</small>
                        <strong><%= recipe.cookTime %> min</strong>
                        </div>                        </div>
                    <% } %>

                    <div class="recipe-info-box">
                        <span class="recipe-info-icon">🍴</span>
                        <div>
                            <small>Ingredients</small>
                            <strong><%= recipe.ingredients.length %></strong>
                        </div>
                    </div>
                </div>

                <% if (user && (recipe.owner._id.equals(user._id) || user.isAdmin)) { %>

                    <div class="recipe-actions">
                        <a href="/recipe/<%= recipe._id %>/update" class="recipe-edit-btn">Edit Recipe</a>

                        <form action="/recipe/<%= recipe._id %>?_method=Delete" method="post">
                            <button type="submit" class="recipe-delete-btn"> Delete Recipe</button>
                        </form>
                    </div>
                <% } %>
            </div>
        </section>

        <section class="recipe-content">

            <div class="recipe-section">
                <h2>Ingredients</h2>

                <div class="ingredients-list">
                    <% for (let oneIngredient of recipe.ingredients) { %>
                        <div class="ingredient-item">
                            <input class="ingredient-check" type="checkbox">
                            <span class="ingredient-name"> <%= oneIngredient.name %></span>
                            <span class="ingredient-quantity"><%= oneIngredient.quantity %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="recipe-section">
                <h2>Steps</h2>
                <div class="recipe-steps">
                    <p><%= recipe.steps %></p>
                </div>
            </div>
        </section>

        <section class="comments-section">
            <h2>Comments</h2>

            <% if (comments.length > 0) { %>
            <div class="comments-list">
                <% for (let oneComment of comments) { %>
                <div class="comment-card">
                    <div id="comment-display-<%= oneComment._id %>" class="comment-display">
                     <div class="comment-header">
                        <strong> <%= oneComment.author.username %></strong>
                     </div>

                     <p><%= oneComment.text %></p>
                     <div class="comment-actions">

                        <% if (user && oneComment.author._id.equals(user._id)) { %>
                         <button type="button" onclick="toggleEdit('<%= oneComment._id %>')" class="comment-edit-btn">Edit</button>
                        <% } %>

                        <% if (user && (oneComment.author._id.equals(user._id) ||recipe.owner._id.equals(user._id) || user.isAdmin)) { %>
                         <form action="/comment/<%= oneComment._id %>?_method=Delete" method="post" >
                            <button type="submit" class="comment-delete-btn">Delete</button>
                         </form>
                         <% } %>
                     </div>
                    </div>

                    <% if (user && oneComment.author._id.equals(user._id)) { %>
                     <form action="/comment/<%= oneComment._id %>?_method=PUT" method="post" 
                      id="comment-edit-<%= oneComment._id %>" style="display:none;" class="comment-edit-form">
                        <textarea name="text"><%= oneComment.text %></textarea>

                     <div>
                        <button type="submit">Save</button>
                        <button type="button" onclick="toggleEdit('<%= oneComment._id %>')">Cancel</button>
                     </div>
                     </form>
                    <% } %>

                </div>
                <% } %>

            </div>
            <% } else { %>
                <p class="no-comments">No comments yet. Be the first to leave one!</p>
            <% } %>

            <% if (user) { %>

                <div class="add-comment">
                    <h3>Leave a comment</h3>
                    <form action="/comment/<%= recipe._id %>" method="POST">
                        <textarea id="text" name="text" placeholder="Share your thoughts about this recipe..." ></textarea>
                        <button type="submit">Post Comment</button>
                    </form>
                </div>
            <% } %>
        </section>   
    </main>

    <footer class="home-footer">
        <div>
            <h4>Recipe Box</h4>
            <p>Delicious ideas, one recipe at a time.</p>
        </div>
        <small>© <%= new Date().getFullYear() %> Recipe Box</small>
    </footer>


    <script>
        function toggleEdit(commentId) {
            const display = document.getElementById('comment-display-' + commentId);
            const editForm = document.getElementById('comment-edit-' + commentId);
            const isEditing = editForm.style.display !== 'none';
            
            display.style.display = isEditing ? '' : 'none';
            editForm.style.display = isEditing ? 'none' : '';
        }
    </script>

    <% const displayError = typeof error !== 'undefined' ? error : ''; %>
    <div id="page-error" data-error="<%= displayError %>"></div>

    <script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
    <script>
        const notyf = new Notyf({ position: { x: 'right', y: 'top' } });
        const pageError = document.getElementById('page-error').dataset.error;
        if (pageError) notyf.error(pageError);
    </script>


</body>
</html>