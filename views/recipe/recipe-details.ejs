<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Recipe Details</h1>

    <h2><%= recipe.title %></h2>
    <h3>Description:</h3>
    <p><%= recipe.description %></p>
    <h3>Cook Time: <%= recipe.cookTime %></h3>
        
    <h3>Ingredients:</h3>
    
    <ul><% for (let oneIngredient of recipe.ingredients) {%>
        <li><%= oneIngredient.name %>: <span><%= oneIngredient.quantity %></span></li>
    <% } %>
    </ul>

    <h3>Steps: </h3>
    <p><%= recipe.steps %></p>

    <% if(user && recipe.owner._id.equals(user._id)) {%>
        <form action="/recipe/<%= recipe._id %>?_method=Delete" method="post">
          <button>Delete Recipe</button>
        </form>

        <a href="/recipe/<%= recipe._id %>/update">Edit Recipe</a>
    <% } %>

    <hr>

    <h3>Comments:</h3>


        <% for (let oneComment of comments) { %>
            <div id="comment-display-<%= oneComment._id %>">
                <strong><%= oneComment.author.username %>:</strong> 
                <%= oneComment.text %>
                <br>
                <% if (user && oneComment.author._id.equals(user._id)) { %>
                    <button type="button" onclick="toggleEdit('<%= oneComment._id %>')">Edit</button>
                <% } %>

            <% if(user && (oneComment.author._id.equals(user._id) || recipe.owner.equals(user._id))) {%>
                <form action="/comment/<%= oneComment._id %>?_method=Delete" method="post">
                <button>Delete Comment</button>
                </form>
            <% } %>
            </div>


            <% if(user && oneComment.author._id.equals(user._id)) {%>
                <form action="/comment/<%= oneComment._id %>?_method=PUT" method="post"
                      id="comment-edit-<%= oneComment._id %>" style="display:none;">
                    <textarea name="text"><%= oneComment.text %></textarea>
                    <button type="submit">Save</button>
                    <button type="button" onclick="toggleEdit('<%= oneComment._id %>')">Cancel</button>
                </form>
            <% } %> 
        <% } %>
  
        <br>
    <form action="/comment/<%= recipe._id %>" method="POST">
        <label for="text">Add a comment:</label>
        <br>
        <textarea id="text" name="text"></textarea>
        <br>
        <button type="submit">Post Comment</button>
    </form>
    
    <script>
    function toggleEdit(commentId) {
        const display = document.getElementById('comment-display-' + commentId);
        const editForm = document.getElementById('comment-edit-' + commentId);
        const isEditing = editForm.style.display !== 'none';

        display.style.display = isEditing ? '' : 'none';
        editForm.style.display = isEditing ? 'none' : '';
    }
</script>

</body>
</html>