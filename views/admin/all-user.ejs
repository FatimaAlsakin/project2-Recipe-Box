<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <%- include('../partials/navbar') %>

    <h1>Admin Dashboard</h1>

    <% for ( let oneUser of allUsers ){ %>
        <% if(! oneUser.isDeleted) {%>
       <h3>username:  <%= oneUser.username %></h3>
       <p>Admin: <%= oneUser.isAdmin %></p>
       <form action="/admin/toggle-admin/<%=oneUser._id %>?_method=PUT" method="post">
            <button><%= oneUser.isAdmin ? "Remove Admin" : "Make Admin" %></button>
       </form>
       
       <form action="/admin/delete/<%=oneUser._id %>?_method=PUT" method="post">
            <button>Delete User </button>
       </form>
    <% }} %>
</body>
</html>